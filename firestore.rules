rules_version = '2';

// ============================================================
//  Règles de sécurité Firestore
//  À coller dans Firebase Console → Firestore Database → Règles
//  Ce sont ELLES qui protègent vraiment vos données :
//  même si quelqu'un modifie le code du site, il ne peut pas
//  dépasser les permissions données par l'administrateur.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function userPath()  { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile(){ return signedIn() && exists(userPath()); }
    function me()        { return get(userPath()).data; }
    function active()    { return hasProfile() && me().active == true; }
    function isAdmin()   { return active() && me().role == 'admin'; }
    function can(p)      { return isAdmin() || (active() && me().permissions.hasAny([p])); }
    function isStaff()   { return active(); }
    function setupDone() { return exists(/databases/$(database)/documents/meta/setup); }

    // ---------- Produits ----------
    match /products/{id} {
      allow read:   if resource.data.published == true || isStaff();
      allow create: if can('products.create');
      allow update: if can('products.edit')
                    || (can('products.create') && resource.data.createdBy == request.auth.uid);
      allow delete: if can('products.delete');
    }

    // ---------- Catégories ----------
    match /categories/{id} {
      allow read:  if true;
      allow write: if can('categories.manage');
    }

    // ---------- Paramètres de la boutique ----------
    match /settings/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---------- Commandes ----------
    match /orders/{id} {
      // Tout visiteur peut envoyer une commande (statut "new" uniquement)
      allow create: if request.resource.data.status == 'new'
                    && request.resource.data.id == id
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && request.resource.data.total is number
                    && request.resource.data.customer.name is string
                    && request.resource.data.customer.phone is string;
      allow read:   if can('orders.view');
      allow update: if can('orders.manage');
      allow delete: if isAdmin();
    }

    // ---------- Utilisateurs ----------
    match /users/{uid} {
      allow read:   if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow update, delete: if isAdmin();
      allow create: if isAdmin()
                    // Premier lancement : le tout premier compte devient administrateur
                    || (signedIn() && request.auth.uid == uid && !setupDone()
                        && existsAfter(/databases/$(database)/documents/meta/setup)
                        && request.resource.data.role == 'admin');
    }

    // ---------- Méta (premier lancement) ----------
    match /meta/{docId} {
      allow read: if true;
      allow create: if docId == 'setup' && signedIn() && !setupDone()
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }
  }
}
